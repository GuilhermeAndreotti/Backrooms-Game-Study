# Copie para .env e ajuste o que precisar. Todos os valores tem padrao sensato,
# entao um .env vazio ja funciona.

# Porta que o servidor Node escuta.
# Se voce usa nginx na frente (recomendado), deixe 3000 e nao abra essa porta
# no firewall. Sem nginx, use 80 e rode o processo com permissao para isso.
PORT=3000

# Interface de escuta. 0.0.0.0 aceita conexoes externas;
# 127.0.0.1 aceita so o proprio servidor (uso com reverse proxy).
HOST=0.0.0.0

# Caminho do WebSocket. So mude se voce alterar tambem o nginx e o cliente.
WS_PATH=/ws

# Jogadores por sala.
ROOM_CAPACITY=4

# Snapshots de movimento enviados por segundo para cada sala.
# 20 e um bom equilibrio; abaixar economiza banda, subir deixa mais fluido.
TICK_HZ=20

# Limites de protecao para uma VPS pequena.
MAX_ROOMS=200
MAX_CONNECTIONS=200
